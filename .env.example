# Public canonical URL used by metadata, sitemap, robots, and OpenGraph.
NEXT_PUBLIC_SITE_URL=https://onebyoneministries.com

# ── Email (contact form) ──────────────────────────────────────────────
# Provider-agnostic. Leave as "console" locally to log instead of sending.
EMAIL_PROVIDER=console            # console | resend
RESEND_API_KEY=
EMAIL_FROM="One By One Ministries <noreply@onebyoneministries.com>"
CONTACT_INBOX=contact@onebyoneministries.com

# ── Newsletter / email list ───────────────────────────────────────────
# Provider-agnostic. Leave as "console" locally.
NEWSLETTER_PROVIDER=console       # console | brevo | mailchimp
BREVO_API_KEY=
BREVO_LIST_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# ── Donations (Stripe) ────────────────────────────────────────────────
# When unset, the /api/donate route responds gracefully (giving disabled).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Legacy / optional ─────────────────────────────────────────────────
# Optional webhook endpoint for the older contact API route.
CONTACT_FORM_WEBHOOK_URL=
