# Public canonical URL used by metadata, sitemap, robots, and OpenGraph.
NEXT_PUBLIC_SITE_URL=https://www.onebyoneministries.org

# Stable Server Action IDs across Vercel builds (required for admin invite/forms after deploy).
# Generate: openssl rand -base64 32
# Set in Vercel Production (and Preview) before build, then redeploy.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Email (contact form + transactional) ────────────────────────────
# Provider-agnostic. Leave as "console" locally to log instead of sending.
EMAIL_PROVIDER=console            # console | brevo | resend
# Brevo on Vercel: prefer SMTP (stable; avoids rotating IP blocks on the REST API).
BREVO_SMTP_USER=                  # Brevo login email (SMTP & API → SMTP tab)
BREVO_SMTP_KEY=                   # Brevo SMTP key (not the v3 API key)
BREVO_API_KEY=                    # Optional fallback if SMTP vars are unset
# If you keep the REST API only, disable Brevo Authorized IPs — Vercel egress IPs change every request.
RESEND_API_KEY=
EMAIL_FROM="One By One Ministries <noreply@onebyoneministries.org>"
CONTACT_INBOX=contact@onebyoneministries.org

# ── Newsletter / email list ───────────────────────────────────────────
# Provider-agnostic. Leave as "console" locally.
NEWSLETTER_PROVIDER=console       # console | brevo | mailchimp
BREVO_API_KEY=
BREVO_LIST_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# ── Donations (Stripe) ────────────────────────────────────────────────
# When unset, the /api/donate route responds gracefully (giving disabled).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Legacy / optional ─────────────────────────────────────────────────
# Optional webhook endpoint for the older contact API route.
CONTACT_FORM_WEBHOOK_URL=

# ── Supabase (auth + image storage) ───────────────────────────────────
# Create a project at https://supabase.com, then add keys from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Drizzle ORM: Supabase → Project Settings → Database → Connection string (URI).
# App/runtime (Vercel): use Transaction pooler, port 6543.
# db:push / migrations: Session pooler port 5432 (drizzle.config auto-switches from 6543).
# Optional override for migrations only:
# DATABASE_URL_MIGRATE=
DATABASE_URL=

# Admin users must have app_metadata.role set to "admin" or "super-admin" in Supabase Auth.
# Service role key (server-only): Project Settings → API → service_role. Used by /setup once.
SUPABASE_SERVICE_ROLE_KEY=
# Never put the service_role / secret key in NEXT_PUBLIC_ vars.
#
# One-time launch: visit /setup (restricted to buyananderson@gmail.com) after env vars are set.
# Reset seeded data + setup lock (add --auth via db:reset:all to also delete all Supabase auth users):
#   npm run db:reset        # tables only
#   npm run db:reset:all    # tables + auth user
#   npm run db:push
# Then run supabase/migrations/20250620120000_init_auth_and_media.sql for RLS + Storage policies.
