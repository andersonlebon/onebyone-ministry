# Public canonical URL used by metadata, sitemap, robots, and OpenGraph.
NEXT_PUBLIC_SITE_URL=https://onebyoneministries.com

# ── Email (contact form + transactional) ────────────────────────────
# Provider-agnostic. Leave as "console" locally to log instead of sending.
EMAIL_PROVIDER=console            # console | brevo | resend
BREVO_API_KEY=                    # Brevo → SMTP & API → API keys (transactional email)
RESEND_API_KEY=
EMAIL_FROM="One By One Ministries <noreply@onebyoneministries.com>"
CONTACT_INBOX=contact@onebyoneministries.com

# ── Newsletter / email list ───────────────────────────────────────────
# Provider-agnostic. Leave as "console" locally.
NEWSLETTER_PROVIDER=console       # console | brevo | mailchimp
BREVO_API_KEY=
BREVO_LIST_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# ── Donations (Stripe) ────────────────────────────────────────────────
# When unset, the /api/donate route responds gracefully (giving disabled).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Legacy / optional ─────────────────────────────────────────────────
# Optional webhook endpoint for the older contact API route.
CONTACT_FORM_WEBHOOK_URL=

# ── Supabase (auth + image storage) ───────────────────────────────────
# Create a project at https://supabase.com, then add keys from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Drizzle ORM: Supabase → Project Settings → Database → Connection string (URI).
# Use the "Transaction" pooler mode for serverless / Vercel.
DATABASE_URL=

# Admin users must have app_metadata.role set to "admin" or "super-admin" in Supabase Auth.
# Service role key (server-only): Project Settings → API → service_role. Used by /setup once.
SUPABASE_SERVICE_ROLE_KEY=
# Never put the service_role / secret key in NEXT_PUBLIC_ vars.
#
# One-time launch: visit /setup (restricted to buyananderson@gmail.com) after env vars are set.
# Reset seeded data + setup lock (add --auth via db:reset:all to also delete the super-admin user):
#   npm run db:reset        # tables only
#   npm run db:reset:all    # tables + auth user
#   npm run db:push
# Then run supabase/migrations/20250620120000_init_auth_and_media.sql for RLS + Storage policies.
